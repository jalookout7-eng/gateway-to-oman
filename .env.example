# Database
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# AI Provider
AI_PROVIDER=groq
GROQ_API_KEY=

# Anthropic (optional — set AI_PROVIDER=anthropic to use Claude Haiku 4.5)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Admin Auth
ADMIN_TOKEN=

# Google OAuth (marketplace "Continue with Google" sign-in)
# Create an OAuth 2.0 Client (type: Web application) in Google Cloud Console.
# Authorized redirect URI: https://<your-domain>/api/businesses/google/callback
# (add http://localhost:3000/api/businesses/google/callback for local dev too)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Cloudflare R2 (media uploads — cover images, gallery, video for listings)
# ─────────────────────────────────────────────────────────────────────────────
# R2_ENDPOINT   — the S3-compatible endpoint for server-side uploads.
#                 Found in R2 bucket settings: https://<account-id>.r2.cloudflarestorage.com
#                 Used only by the server (never exposed to the browser).
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# R2_BUCKET     — bucket name (e.g. gto-listings)
R2_BUCKET=gto-listings

# R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY — R2 API token credentials.
#   Generate in Cloudflare dashboard → R2 → Manage R2 API tokens.
#   Grant "Object Read & Write" on the bucket.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# R2_PUBLIC_BASE_URL — the public base URL where uploaded objects can be read
#   by browsers without authentication. This is DIFFERENT from R2_ENDPOINT.
#   You MUST set this in production after enabling public access on the bucket:
#     Option A — R2.dev subdomain: enable "Public access" in R2 bucket settings.
#                URL looks like https://<hash>.r2.dev
#     Option B — Custom domain: bind media.gatewaytooman.com in Cloudflare.
#                URL looks like https://media.gatewaytooman.com
#   WARNING: if left unset, uploaded images will return auth-required URLs that
#   are NOT viewable in the browser. The upload route will still work, but
#   images will 403 on the public listing page.
R2_PUBLIC_BASE_URL=

# Email (configure via admin UI or env vars)
EMAIL_PROVIDER=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
SENDGRID_API_KEY=
EMAIL_FROM_NAME=Ahmed Al-Azizi — Gateway to Oman
EMAIL_FROM_ADDRESS=
EMAIL_REPLY_TO=azizi@alazizigroup.com
